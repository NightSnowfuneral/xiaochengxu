{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mock-login": ["src/dev/mockLogin.ts"]
    },
    "types": [
      "@tarojs/taro",
      "webpack-env",
      "node"
    ]
  },
  "include": [
    "src",
    "config",
    "types"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
