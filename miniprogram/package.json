{
  "name": "huahuo-spark-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "禾下美学院｜知识付费 C 端微信小程序",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp:prod": "cross-env NODE_ENV=production taro build --type weapp",
    "build:weapp:online": "cross-env NODE_ENV=production TARO_APP_API_BASE_URL=https://api.qinghebacademy.cn/api/v1 taro build --type weapp",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 5",
    "iOS >= 9"
  ],
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/router": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webpack-env": "^1.18.8",
    "babel-preset-taro": "4.3.1",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.1",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "webpack": "5.91.0"
  }
}
