# =============================================================================
# 禾下美学院 环境变量模板
# 使用方式：复制为 .env 后填写真实值。.env 与任何真实密钥禁止提交到仓库。
# =============================================================================

# -----------------------------------------------------------------------------
# 基础
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=huahuo-spark
API_PREFIX=/api/v1
# 应用日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL，生产建议 INFO
LOG_LEVEL=INFO
# 允许跨域访问的 B 端来源，逗号分隔；生产同源部署无需修改
# 生产：CORS_ALLOW_ORIGINS=https://api.qinghebacademy.cn
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# MySQL 8.0
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=huahuo_spark
MYSQL_USER=spark
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
# 注意：密码包含 @ : / ? # 等字符时需 URL 编码；Compose 内会使用服务名 mysql 覆盖此地址
DATABASE_URL=mysql+aiomysql://spark:change_me@127.0.0.1:3306/huahuo_spark?charset=utf8mb4

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# 学习进度缓冲 TTL（秒），默认 7 天
STUDY_PROGRESS_TTL_SECONDS=604800
# 学习进度批量落库周期（秒）
STUDY_PROGRESS_FLUSH_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# C 端用户 JWT（与 Admin JWT 必须使用不同密钥）
# -----------------------------------------------------------------------------
USER_JWT_SECRET=replace_with_a_long_random_string
USER_JWT_ALGORITHM=HS256
USER_JWT_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# B 端管理员 JWT（与 C 端 JWT 必须使用不同密钥）
# -----------------------------------------------------------------------------
ADMIN_JWT_SECRET=replace_with_another_long_random_string
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# 初始管理员（首次启动由后端初始化脚本创建；生产环境必须改为强密码）
# -----------------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_before_production

# -----------------------------------------------------------------------------
# 微信小程序（必须在微信公众平台获取后填写；禁止提交真实值）
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret

# -----------------------------------------------------------------------------
# 微信支付（v3）
# -----------------------------------------------------------------------------
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL_NO=
# 容器内路径；宿主机文件放在 deploy/secrets/ 下并由 Compose 只读挂载到 /run/secrets
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay_apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
# 新版商户（无平台证书）必须同时配置「微信支付公钥」与公钥 ID；
# 两者留空时回退到旧的平台证书模式。公钥 ID 形如 PUB_KEY_ID_...
# 公钥既可通过文件路径提供，也可直接以 PEM 内容写入 WECHAT_PAY_PUBLIC_KEY；
# 同时配置时优先使用内容。私钥始终只从文件读取，禁止写入环境变量。
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
# 本地开发可指向内网穿透地址；生产必须是公网 HTTPS
WECHAT_PAY_NOTIFY_URL=https://api.qinghebacademy.cn/api/v1/payments/wechat/notify
# 支付成功后课程授权有效天数（默认 365；仅后台可见有效期）
COURSE_VALID_DAY=365
# 待支付订单超过该分钟数后由定时任务自动关闭（默认 30）
ORDER_CLOSE_TIMEOUT_MINUTES=30
# 超时关单扫描周期（秒，默认 300，即 5 分钟）
ORDER_CLOSE_SCAN_INTERVAL_SECONDS=300
# 每日对账周期（秒，默认 86400）与回溯订单天数（默认 7）
ORDER_RECONCILE_INTERVAL_SECONDS=86400
ORDER_RECONCILE_LOOKBACK_DAYS=7

# -----------------------------------------------------------------------------
# 微信小程序虚拟支付（xpay）消息推送 + 下单签名
# 正式与沙箱各自三项必须同时配置；禁止提交真实值。
# AppKey 用于服务端下单签名（paySig），不参与回调验签。
# 两套 MSG_TOKEN / ENCODING_AES_KEY 必须不同，否则无法区分环境。
# OFFER_ID 来自虚拟支付后台「支付基础配置」，现网/沙箱共用。
# -----------------------------------------------------------------------------
WECHAT_XPAY_PROD_APP_KEY=
WECHAT_XPAY_PROD_MSG_TOKEN=
WECHAT_XPAY_PROD_ENCODING_AES_KEY=
WECHAT_XPAY_SANDBOX_APP_KEY=
WECHAT_XPAY_SANDBOX_MSG_TOKEN=
WECHAT_XPAY_SANDBOX_ENCODING_AES_KEY=
WECHAT_XPAY_OFFER_ID=
# 已处理订单的 Redis 幂等键 TTL（秒，默认 30 天）
WECHAT_XPAY_IDEMPOTENCY_TTL_SECONDS=2592000
# 回调报文上限（字节，默认 48 KiB；必须小于 TEXT 64 KiB）
WECHAT_XPAY_MAX_BODY_BYTES=49152

# -----------------------------------------------------------------------------
# 腾讯云 COS（课程图片预签名上传）
# -----------------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# 腾讯云 VOD（加密视频临时播放签名）
# -----------------------------------------------------------------------------
VOD_APP_ID=
VOD_PLAY_KEY=
VOD_PLAY_KEY_EXPIRE_SECONDS=7200
# 上传后自动执行的加密转码任务流模板名（如 SimpleAesEncryptPreset）
VOD_UPLOAD_PROCEDURE=
# 单个视频上传大小上限（MB）
VOD_UPLOAD_MAX_SIZE_MB=2048

# -----------------------------------------------------------------------------
# 前端构建变量（仅非敏感信息）
# 本地开发默认值；生产由 deploy/prepare-prod-env.sh 覆盖：
#   TARO_APP_API_BASE_URL=https://api.qinghebacademy.cn/api/v1
#   VITE_API_BASE_URL=/api/v1   # 后台与 /admin/ 同源，允许相对路径
# -----------------------------------------------------------------------------
TARO_APP_API_BASE_URL=http://127.0.0.1:18000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:18000/api/v1

# -----------------------------------------------------------------------------
# 本地开发基础设施（供 Compose 使用）
# -----------------------------------------------------------------------------
REDIS_PORT=6379
